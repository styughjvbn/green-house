FROM redgate/flyway:11 AS flyway

FROM postgres:14-bookworm

COPY --from=flyway /flyway /flyway
COPY scripts/demo/requirements.txt /tmp/requirements.txt

RUN apt-get update \
    && apt-get install -y --no-install-recommends default-jre-headless python3 python3-pip \
    && python3 -m pip install --break-system-packages -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/flyway:${PATH}"

WORKDIR /workspace

ENTRYPOINT ["/bin/bash"]

FROM redgate/flyway:11 AS flyway

FROM eclipse-temurin:21-jdk AS backend-builder

COPY backend /opt/green-house/backend

RUN cd /opt/green-house/backend \
    && ./gradlew --no-daemon bootJar

FROM postgres:14-bookworm

COPY --from=flyway /flyway /flyway
COPY --from=backend-builder /opt/java/openjdk /opt/java/openjdk
COPY --from=backend-builder /opt/green-house/backend /opt/green-house/backend
COPY --from=backend-builder /root/.gradle /root/.gradle
COPY scripts/demo/requirements.txt /tmp/requirements.txt

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && python3 -m pip install --break-system-packages -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME="/opt/java/openjdk"
ENV PATH="/flyway:/opt/java/openjdk/bin:${PATH}"

WORKDIR /workspace

ENTRYPOINT ["/bin/bash"]

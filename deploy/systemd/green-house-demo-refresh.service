[Unit]
Description=Green House sanitized demo database refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sjw
Group=sjw
WorkingDirectory=/opt/green-house/current
EnvironmentFile=/etc/green-house/demo-refresh.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/green-house/current/scripts/demo/scheduled-demo-refresh.sh
TimeoutStartSec=2h
UMask=0077
PrivateTmp=false

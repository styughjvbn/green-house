[Unit]
Description=Green House sanitized demo database refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sjw
Group=sjw
WorkingDirectory=/home/sjw/projects/green-house
EnvironmentFile=/etc/green-house/demo-refresh.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStart=/home/sjw/projects/green-house/scripts/demo/scheduled-demo-refresh.sh
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=true
PrivateTmp=false

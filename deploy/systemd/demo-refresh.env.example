# Install as /etc/green-house/demo-refresh.env, owned by root:sjw with mode 0640. Do not commit real secrets.
PRODUCTION_DB_URL=postgresql://greenhouse:CHANGE_ME@127.0.0.1:5432/greenhouse
PRODUCTION_DB_NAME=greenhouse
DEMO_DB_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
DEMO_DB_URL=postgresql://greenhouse_demo:CHANGE_ME@127.0.0.1:5432/greenhouse_demo
DEMO_DB_NEXT_URL=postgresql://greenhouse_demo:CHANGE_ME@127.0.0.1:5432/greenhouse_demo_next
DEMO_NEXT_FLYWAY_URL=jdbc:postgresql://127.0.0.1:5432/greenhouse_demo_next
DEMO_DB_PASSWORD=CHANGE_ME
DEMO_ANONYMIZATION_KEY=CHANGE_TO_A_STABLE_SECRET_OF_AT_LEAST_32_CHARACTERS
DEMO_DATE_SHIFT_DAYS=365
DEMO_QUANTITY_FACTOR=2
DEMO_PRICE_FACTOR=2
DEMO_SOURCE_DUMP_CONFIRM=greenhouse
DEMO_REFRESH_CONFIRM=greenhouse_demo:greenhouse_demo_next:greenhouse_demo_prev
DEMO_SANITIZED_DUMP_DIR=/opt/green-house/backups/demo-sanitized
DEMO_SANITIZED_DUMP_KEEP=3
DEMO_API_SMOKE_URL=https://green-house-demo.sjw-project.site/api/dashboard/summary
KUBECONFIG=/home/sjw/.kube/config

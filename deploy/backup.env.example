# Copy once to deploy/backup.env (Git excluded, mode 600).
# Literal values only; quote spaces. Exported environment variables take precedence.
# Confirm these DB settings against the existing production backup script.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=greenhouse
PGUSER=greenhouse
PGPASSFILE=/home/sjw/.pgpass
# To use a libpq service, remove the four explicit connection keys above.
# PGSERVICE=greenhouse
# PGSERVICEFILE=/home/sjw/.pg_service.conf

SALES_PHOTO_STORAGE_ROOT=/opt/green-house/data/slip-photos
LOCAL_BACKUP_DIR=/opt/green-house/backups/local
RCLONE_CONFIG=/home/sjw/.config/rclone/rclone.conf
# Intentionally empty. Set the actual remote, e.g. gdrive:green-house-backups.
# The script appends db/, photos/, replaced/ and manifests/ below this root.
RCLONE_BACKUP_REMOTE=
GREENHOUSE_OPERATION_LOCK_FILE=/tmp/green-house-operation.lock

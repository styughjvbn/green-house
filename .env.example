# 전체 애플리케이션 설정 목록. 루트 .env는 개발 전용이며 커밋하지 않습니다.
# [B] Spring backend / [F] Next.js server / [R] AI runtime
# [secret] 운영에서는 Secret 또는 런타임 전용 비밀값 저장소로 주입합니다.
# 주석 처리된 항목은 코드 기본값 또는 선택 설정 예시입니다. 필요한 항목만 .env 또는 ConfigMap에 지정합니다.
# 개발 로더 우선순위: 이미 export된 환경변수 > 루트 .env > 코드 기본값.

# 공통 실행 / 프록시 [B+F]
APP_ENV=dev
BACKEND_API_URL=http://127.0.0.1:8080/api
NEXT_PUBLIC_API_BASE_URL=/api
# [B] dev-start.sh --lan은 현재 PC의 IPv4 주소(:3000)를 추가합니다.
FRONTEND_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
# [B] SERVER_PORT=8080
# [B] SPRING_PROFILES_ACTIVE=prod  # 운영 ConfigMap에서만 지정
# [B] SERVER_FORWARD_HEADERS_STRATEGY=framework  # 신뢰하는 프록시 뒤에서 필요할 때
# 이전 별칭: API_BASE_URL -> BACKEND_API_URL, FRONTEND_ORIGIN(S) -> FRONTEND_ORIGIN_PATTERNS

# [B] DB 접속
DATABASE_URL=jdbc:postgresql://localhost:5432/greenhouse
DATABASE_USERNAME=greenhouse
DATABASE_PASSWORD=greenhouse
# DATABASE_PASSWORD: [secret], 위 값은 로컬 docker-compose 전용
# JPA_DDL_AUTO=validate
# DB_POOL_MAX_SIZE=10
# DB_POOL_MIN_IDLE=2
# DB_POOL_CONNECTION_TIMEOUT=30000
# POSTGRES_REWRITE_BATCHED_INSERTS=true
# HIBERNATE_JDBC_BATCH_SIZE=50
# Flyway는 기본적으로 DATABASE_*를 재사용합니다. 별도 DDL 계정일 때만 지정합니다.
# FLYWAY_URL=jdbc:postgresql://localhost:5432/greenhouse
# FLYWAY_USERNAME=greenhouse
# FLYWAY_PASSWORD=  # [secret]

# [B] 인증 / 세션 — 운영 계정은 Secret에 지정
# AUTH_ENABLED=true
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin  # [secret], 개발 기본값
# WORKER_USERNAME=worker
# WORKER_PASSWORD=worker  # [secret], 개발 기본값
# SESSION_TIMEOUT=7d
# SESSION_COOKIE_MAX_AGE=7d

# [B] 원장 / API 문서
# ORCHID_LEDGER_WRITER_VERSION=2.0.0
# ORCHID_LEDGER_STARTUP_GUARD_ENABLED=true
# SPRINGDOC_API_DOCS_ENABLED=true  # 운영 ConfigMap에서는 false
# SPRINGDOC_SWAGGER_UI_ENABLED=true  # 운영 ConfigMap에서는 false
# FEATURES_STOCK_COUNT_ENABLED=false
# FEATURES_WORK_QUANTITY_CORRECTION_ENABLED=false

# [B] 데모 — k8s 운영 base 대신 demo overlay에서 설정
# DEMO_MODE=false
# DEMO_USERNAME=demo
# DEMO_REQUEST_LIMIT_PER_MINUTE=120
# DEMO_MUTATION_LIMIT_PER_MINUTE=30
# DEMO_MUTATION_LIMIT_PER_DAY=300
# DEMO_MAX_REQUEST_BYTES=262144

# [B+F] 사진 전처리 — 양쪽에 같은 값 주입
# SALES_DOCUMENT_IMAGE_WORKERS=3  # 1이면 순차 처리
# [B] 아래 항목은 서버 전처리 옵션
# SALES_DOCUMENT_IMAGE_QUEUE_CAPACITY=4
# SALES_DOCUMENT_IMAGE_OPENCV_THREADS=1
# SALES_DOCUMENT_IMAGE_MAX_DIMENSION=2048
# SALES_DOCUMENT_IMAGE_DOCUMENT_SEPARATION_ROW_MULTIPLIER=5.5
# SALES_DOCUMENT_IMAGE_DOCUMENT_HEADER_ROW_MULTIPLIER=7

# [B] 전표 사진 저장 — 상대 경로는 backend 작업 디렉터리 기준
# SALES_PHOTO_STORAGE_TYPE=local
# SALES_PHOTO_STORAGE_ROOT=./data/slip-photos
# 운영 ConfigMap: SALES_PHOTO_STORAGE_ROOT=/var/lib/greenhouse/slip-photos (PVC)

# [B+R] AI 공유 설정 — 동일한 값으로 주입, 키는 무작위 32자 이상
AI_RUNTIME_SECRET=
# AI_RUNTIME_SECRET: [secret], 운영 backend Secret과 별도 AI runtime에 동일하게 지정
# AI_TIMEOUT_SECONDS=120
# AI_MAX_TOOL_CALLS=20

# [B] AI 연결 — 운영 런타임 주소는 실제 배치 위치에 맞게 별도로 지정
# AI_RUNTIME_URL=http://127.0.0.1:8091
# AI_DEFAULT_AUCTION_PARTNER_ID=0  # 수탁증 기본 경매장 ID, 0이면 자동 연결하지 않음

# [R] AI runtime 전용 — backend/frontend ConfigMap에 일괄 복사하지 않습니다.
# AI_PROVIDER=codex
# AI_HOST=127.0.0.1
# AI_PORT=8091
# AI_TOOLS_URL=http://127.0.0.1:8080
# AI_MIN_CONFIDENCE=80
# AI_CODEX_HOME=  # Codex 사용 시 전용 인증·설정 디렉터리 필수
# AI_CODEX_MODEL=  # 비어 있으면 전용 Codex config.toml의 모델 사용
# OPENAI_API_KEY=  # [secret], AI_PROVIDER=openai일 때만 필요
# AI_OPENAI_MODEL=gpt-4.1-mini

# Frontend developer tools [F]
REACT_EDITOR=code

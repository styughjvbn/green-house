APP_ENV=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/greenhouse
DATABASE_USERNAME=greenhouse
DATABASE_PASSWORD=greenhouse
FLYWAY_URL=jdbc:postgresql://localhost:5432/greenhouse
FLYWAY_USERNAME=greenhouse
FLYWAY_PASSWORD=greenhouse
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT=30000
JPA_DDL_AUTO=update
SERVER_PORT=8080
BACKEND_API_URL=http://localhost:8080/api
NEXT_PUBLIC_API_BASE_URL=/api
FRONTEND_ORIGIN=http://localhost:3000
WORK_OPERATION_V2_ENABLED=false
DEMO_MODE=false
DEMO_USERNAME=demo
DEMO_REQUEST_LIMIT_PER_MINUTE=120
DEMO_MUTATION_LIMIT_PER_MINUTE=30
DEMO_MUTATION_LIMIT_PER_DAY=300
DEMO_MAX_REQUEST_BYTES=262144

# AI runtime (server only; Spring and Node share this secret)
AI_RUNTIME_URL=http://127.0.0.1:8091
AI_RUNTIME_SECRET=
AI_TOOLS_URL=http://127.0.0.1:8080
AI_PROVIDER=codex
AI_CODEX_HOME=
AI_CODEX_MODEL=
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=120
AI_MAX_TOOL_CALLS=20
# 수탁증에 거래처명이 없을 때 연결할 활성 경매장 ID. 0이면 자동 연결하지 않음
AI_DEFAULT_AUCTION_PARTNER_ID=3

# AI self-rated confidence threshold (0-100); lower scores retry at up to 2048px
AI_MIN_CONFIDENCE=80

# Image preprocessing: export the same value to Spring and Next.js (1 = sequential)
SALES_DOCUMENT_IMAGE_WORKERS=3
